<?xml version="1.0"?>
<robot name="custom_kuka_kr6">
  <link name="world"/>
  <joint name="world_fixed" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <mass value="12.0000"/>
      <origin xyz="0.00000 0.00000 0.07500" rpy="0 0 0"/>
